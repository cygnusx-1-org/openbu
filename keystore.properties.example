# Template for keystore.properties, which holds the signing credentials for release builds.
#
# This file is only needed to produce *signed* artifacts. Debug builds work without it:
# ./gradlew assembleDirectDebug uses the standard Android debug keystore.
#
# To use it, copy this file to keystore.properties (which is gitignored, and must stay that
# way) and fill in your own values. Any key left out is simply skipped, so a partially filled
# file is fine — for example, only the release keys if you never build a Play bundle.
#
#   cp keystore.properties.example keystore.properties
#
# storeFile paths are resolved relative to the app/ module directory, so prefer absolute paths.

# Used by the "direct" flavor (sideloaded APKs), signed with your own release key.
keyAlias=openbu
keyPassword=changeit
storeFile=/absolute/path/to/release.jks
storePassword=changeit

# Used by the "play" flavor (AAB uploads), signed with the Play upload key.
uploadKeyAlias=openbu-upload
uploadKeyPassword=changeit
uploadStoreFile=/absolute/path/to/upload.jks
uploadStorePassword=changeit
